# --- App ---
APP_ENV=local
APP_SECRET=change-me-in-prod
APP_PORT=8000

# --- Postgres (OLTP) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lumen
POSTGRES_USER=lumen
POSTGRES_PASSWORD=lumen
DATABASE_URL=postgresql+psycopg2://lumen:lumen@localhost:5432/lumen

# --- BigQuery (warehouse) ---
GCP_PROJECT_ID=your-gcp-project
BQ_DATASET_RAW=lumen_raw
BQ_DATASET_MART=lumen_mart
GOOGLE_APPLICATION_CREDENTIALS=./deploy/gcp-sa.json

# --- Cube.dev ---
CUBE_API_SECRET=cube-secret-change-me
CUBEJS_DB_TYPE=postgres
CUBEJS_DB_HOST=postgres
CUBEJS_DB_PORT=5432
CUBEJS_DB_NAME=lumen
CUBEJS_DB_USER=lumen
CUBEJS_DB_PASS=lumen
CUBEJS_API_URL=http://localhost:4000/cubejs-api/v1
CUBEJS_DEV_MODE=true

# --- Airflow ---
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@airflow-db:5432/airflow
