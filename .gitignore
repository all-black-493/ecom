# --- Secrets — NEVER COMMIT ---------------------------------------------------
# These contain passwords, API keys, and service-account credentials.
.env
.env.local
.env.*.local
deploy/gcp-sa.json
deploy/*.json
*.pem
*.key

# --- Python virtualenvs and build artifacts -----------------------------------
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
build/
dist/
.eggs/
.installed.cfg

# Test & lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/

# --- Cube.dev local runtime state (owned by root, breaks git) -----------------
cube/.cubestore/
cube/node_modules/

# --- Local databases / docker volumes -----------------------------------------
*.sqlite
*.sqlite3
postgres-data/
airflow-data/

# --- ML generated outputs (regenerated by `make forecast`) --------------------
ml/forecast_metrics.json
ml/forecast_categories.csv
ml/sample_history.csv

# --- Session / agent files ----------------------------------------------------
.remember/
.agents/
skills-lock.json
.claude/

# --- Playwright MCP scratch output ---------------------------------------------
.playwright-mcp/

# --- IDE & OS junk ------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Logs ---------------------------------------------------------------------
*.log
logs/

# --- Compiled Cube outputs ----------------------------------------------------
cube/dist/

# --- Locust HTML reports if generated -----------------------------------------
locust-report-*.html
